# APAAR-Vault Environment Configuration Template

# Database configuration
# Default is SQLite for instant zero-dependency local hackathon run.
# For PostgreSQL: postgresql+psycopg2://apaar_user:apaar_pass@localhost:5432/apaar_vault
DATABASE_URL=sqlite:///./apaar_vault.db

# Security & JWT
SECRET_KEY=apaar-vault-hackathon-secure-secret-key-32chars-min-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Environment
ENVIRONMENT=development
DEBUG=True

# Demonstration Mode Flag
# When True, simulated APAAR verification and synthetic seed markers are displayed.
DEMO_MODE=True

# Official APAAR Integration (Mocked/Simulated unless authorized endpoints provided)
APAAR_API_BASE_URL=https://api.mock-apaar.gov.in/v1
APAAR_API_KEY=mock-demonstration-key

# AICTE API Integration
AICTE_API_BASE_URL=https://api.mock-aicte.gov.in/v1
AICTE_API_KEY=mock-aicte-key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
